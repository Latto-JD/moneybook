# 값은 비워 두고 이름과 설명만 둔다. 실제 값은 .env(로컬) 또는 Vercel 환경변수에 설정한다.

# Postgres 연결 문자열 (프로덕션 필수, Neon pooled). Vercel Marketplace 통합이 자동 주입
DATABASE_URL=
# 마이그레이션용 직접 연결 문자열 (없으면 DATABASE_URL 사용)
DATABASE_URL_UNPOOLED=
# pglite 이면 내장 DB 사용 (로컬/테스트 전용, 프로덕션에서는 설정 금지)
DB_DRIVER=
# PGlite 데이터 디렉터리 (기본 .data/pglite)
PGLITE_DIR=
# 세션 쿠키 Secure 속성 (기본 true, 로컬 http 에서만 false)
COOKIE_SECURE=
# 가입 허용 여부 (기본 true, false 면 가입 403)
SIGNUP_ENABLED=
# 같은 호스트 외 추가로 허용할 Origin 목록 (쉼표 구분, 예: https://example.com)
APP_ORIGINS=
# true 면 로컬 개발 서버가 x-forwarded-for 를 신뢰 (IP 제한 재현용)
TRUST_PROXY=
# 로컬 개발 서버 포트 (기본 3000)
PORT=
# true 면 개발 서버에 QA 전용 /__qa/* 엔드포인트 활성화 (DB_DRIVER=pglite 일 때만, 프로덕션 금지)
QA_TOOLS=
